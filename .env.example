# Copy this file to .env.local and fill in your values

# ============================================
# Supabase (from Project Settings → API)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key

# ============================================
# Resend (from resend.com/api-keys)
# ============================================
RESEND_API_KEY=re_...your-key
EMAIL_FROM=BloomieVacation <onboarding@resend.dev>
# In production, change to: noreply@yourdomain.com after domain verification

# ============================================
# App config
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production: https://yourdomain.com
# Optional server override for emails/cron when NEXT_PUBLIC_APP_URL is still localhost:
# APP_URL=https://yourdomain.com

# ============================================
# System admin (do not change)
# ============================================
SYSTEM_ADMIN_EMAIL=vekaz.hadzic@bloomteq.com
